@model MigrationUpload
@{
    ViewData["Title"] = $"Upload #{Model.Id}";
    var needsAction = Model.Records.Count(r => !IsNoAction(r));
}
@functions {
    private static bool IsNoAction(MigrationRecord r) =>
        r.Action.Equals("No action", StringComparison.OrdinalIgnoreCase);
}

<a asp-action="Index" class="small">&larr; All uploads</a>
<h1 class="h3 mt-2 mb-3">@Model.FileName</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<dl class="row small mb-4">
    <dt class="col-sm-2">Uploaded by</dt>
    <dd class="col-sm-10"><code>@Model.UploadedBy</code> @Model.Uploader?.FullName, @Model.Uploader?.Designation</dd>
    <dt class="col-sm-2">District</dt>
    <dd class="col-sm-10"><code>@Model.DistrictId</code></dd>
    <dt class="col-sm-2">Uploaded at</dt>
    <dd class="col-sm-10">@Model.UploadedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
    <dt class="col-sm-2">Rows</dt>
    <dd class="col-sm-10">@Model.RowCount (@needsAction need action)</dd>
</dl>

<div class="table-responsive">
    <table class="table table-bordered table-sm migration-table">
        <thead>
            <tr class="group">
                <th colspan="6">Existing Position</th>
                <th colspan="5">Rationalization - Activity Identification</th>
            </tr>
            <tr>
                <th>AC No. &amp; Name</th>
                <th>Part No.</th>
                <th>Part Name</th>
                <th>Section</th>
                <th>Break-up type</th>
                <th>Electors</th>
                <th>Part No.</th>
                <th>Part Name</th>
                <th>Section</th>
                <th>Electors</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Records)
            {
                var changed = !IsNoAction(r);
                <tr>
                    <td>@r.AcNoName</td>
                    <td>@r.ExistingPartNo</td>
                    <td>@r.ExistingPartName</td>
                    <td>@r.ExistingSection</td>
                    <td>@r.BreakupType</td>
                    <td class="text-nowrap">@r.ExistingElectors</td>
                    <td class="@(changed ? "fw-bold" : "")">@r.RationalizedPartNo</td>
                    <td>@r.RationalizedPartName</td>
                    <td>@r.RationalizedSection</td>
                    <td>@r.RationalizedElectors</td>
                    <td class="@(changed ? "text-primary" : "")">@r.Action</td>
                </tr>
            }
        </tbody>
    </table>
</div>
